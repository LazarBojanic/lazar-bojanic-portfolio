---
layout: layouts/base.liquid
title: "Blog"
description: "Welcome to my blog!"
permalink: "/blog/index.html"
eleventyExcludeFromCollections: true
---

<div class="page-hero">
    <h1 class="hero-title">Blog</h1>
    <p class="hero-description">Welcome to my blog!</p>
</div>

<div class="blog-list">
    {% for post in collections.posts reversed %}
        <a href="{{ post.url }}" class="blog-card">
            {% if post.data.image %}
                <div class="blog-card-image-wrap">
                    <img src="{{ post.data.image }}" alt="{{ post.data.title }}" class="blog-card-image"
                         loading="lazy"/>
                </div>
            {% endif %}
            <div class="blog-card-content">
                <div class="blog-meta">
                    {% if post.data.date %}
                        <span>{{ post.data.date | readableDate }}</span>
                    {% endif %}
                    {% if post.data.minRead %}
                        <span>• {{ post.data.minRead }} min read</span>
                    {% endif %}
                </div>
                <h2 class="blog-card-title">{{ post.data.title }}</h2>
                <p class="blog-card-desc">{{ post.data.description }}</p>
            </div>
        </a>
    {% endfor %}
</div>
