---
layout: layouts/base.liquid
title: "Projects"
description: "A collection of my work and projects."
---

<div class="page-hero">
    <h1 class="hero-title">Projects</h1>
    <p class="hero-description">A collection of my work and projects.</p>
</div>

<div class="projects-grid">
    {% for project in collections.projects %}
        <div class="project-card">
            <div class="project-image-wrapper">
                <img src="{{ project.data.image }}" alt="{{ project.data.title }}" class="project-image"
                     loading="lazy"/>
            </div>
            <div class="project-content">
                <h2 class="project-title">{{ project.data.title }}</h2>
                <p class="project-desc">{{ project.data.description }}</p>

                {% if project.data.tags %}
                    <div class="project-tags">
                        {% for tag in project.data.tags %}
                            <span class="tag-badge">{{ tag }}</span>
                        {% endfor %}
                    </div>
                {% endif %}

                <div class="project-footer">
                    {% if project.data.url and project.data.url != "#" %}
                        <a href="{{ project.data.url }}" target="_blank" rel="noopener noreferrer" class="btn">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                                <path d="M9 18c-4.51 2-5-2-7-2"/>
                            </svg>
                            View on GitHub
                        </a>
                    {% else %}
                        <button class="btn" disabled>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            </svg>
                            Private Repository
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endfor %}
</div>
